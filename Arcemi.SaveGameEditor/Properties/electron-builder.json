{
  "appId": "com.Arcemi.SaveGameEditor.app",
  "productName": "Arcemi Save Game Editor",
  "copyright": "Copyright © 2025",
  "buildVersion": "3.0.0",
  "icon": "app/app-icon.png",
  "asar": true,
  "compression": "maximum",
  "extraResources": [
    {
      "from": "./bin",
      "to": "bin",
      "filter": [
        "**/*",
        "!**/*.pdb",
        "!**/*.xml"
      ]
    }
  ],
  "files": [
    "**/*",
    "!**/*.pdb",
    "!**/*.xml",
    "!**/obj/**",
    "!**/bin/**"
  ]
}
