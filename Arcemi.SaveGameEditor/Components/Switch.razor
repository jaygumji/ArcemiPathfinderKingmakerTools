<div class="form-check form-switch">
    <input id="@Id" type="checkbox" class="form-check-input" @oninput="OnIsCheckedChangedAsync" @bind="IsCheckedBind" disabled="@IsReadOnly" />
    <label for="@Id" class="form-check-label">@Label</label>
</div>

@code {
    [Parameter]
    public RenderFragment Label { get; set; }

    [Parameter]
    public bool IsChecked { get; set; }

    [Parameter]
    public EventCallback<bool> IsCheckedChanged { get; set; }

    [Parameter]
    public string Id { get; set; }

    [Parameter]
    public bool IsReadOnly { get; set; }

    private bool IsCheckedBind;

    private async Task OnIsCheckedChangedAsync(ChangeEventArgs e)
    {
        if (IsReadOnly) return;
        var value = (bool)e.Value;
        IsChecked = value;
        await IsCheckedChanged.InvokeAsync(value);
    }

    protected override void OnInitialized()
    {
        if (string.IsNullOrEmpty(Id)) {
            Id = System.Guid.NewGuid().ToString("N");
        }
    }

    protected override void OnParametersSet()
    {
        if (IsCheckedBind != IsChecked) {
            IsCheckedBind = IsChecked;
        }
    }
}