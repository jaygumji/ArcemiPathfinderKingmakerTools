@inject CharacterViewModel Model

@if (_statError is not null) {
    <p class="alert alert-warning" role="alert">@_statError</p>
}

@foreach (var grouping in Unit.Stats.Groupings.Where(g => g.Count > 0)) {
    <div class="row">
        <h3 class="col-md-12">@grouping.Name</h3>
    </div>
    <div class="form-list static-content">
        <div class="row">
            <div class="col-md-4">
                <label class="form-label">Name</label>
            </div>
            <div class="col-md-2">
                <label class="form-label">Value</label>
            </div>
            <div class="col-md-2">
               <label class="form-label">@grouping.InfoHeader</label>
            </div>
        </div>
        @foreach (var stat in grouping) {
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">@stat.Name</label>
                </div>
                <div class="col-md-2">
                    <input class="form-control" type="number" step="@stat.Step" min="@stat.Minimum" max="@stat.Maximum"
                           @bind:get="stat.Value" @bind:set="value => ApplyValue(stat, value)" disabled="@(!Model.CanEdit || stat.IsReadOnly)" />
                </div>
                <div class="col-md-2">
                    @stat.Info
                </div>
            </div>
        }
    </div>
}

@code {
    [Parameter]
    public IGameUnitModel Unit { get; set; }

    private string _statError;

    protected override void OnParametersSet() => _statError = null;

    private void ApplyValue(IGameUnitStatsEntry stat, int value)
    {
        _statError = stat.TrySetValue(value)
            ? null
            : $"{stat.Name} requires increments of {stat.Step} between {stat.Minimum} and {stat.Maximum}.";
    }
}
