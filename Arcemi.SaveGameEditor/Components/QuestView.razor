@if (EnableSpoilerAlert || Quests.Any(quest => !quest.IsReadOnly)) {
    <p class="alert alert-warning">
        @if (EnableSpoilerAlert) {
            <strong>Spoiler alert</strong><br />
        }
        @if (Quests.Any(quest => !quest.IsReadOnly)) {
            <span>Changing quest state can break progression.</span>
        }
    </p>
}

<AccordionContainer>
    @foreach(var quest in Quests) {
        <Accordion HeaderText="@quest.Name">
        <div class="row">
            <div class="col-md-3">
                <label class="form-label">State</label>
                @if (quest.IsReadOnly) {
                    <input class="form-control" type="text" readonly value="@quest.State" />
                }
                else {
                    <select class="form-select" @bind="quest.State">
                        <option value="None">None</option>
                        <option value="Started">Started</option>
                        <option value="Completed">Completed</option>
                        <option value="Failed">Failed</option>
                    </select>
                }
            </div>
        </div>
        <div class="row">
            <h4 class="col-md-12">Steps</h4>
        </div>
        <div class="form-list static-content">
            <div class="row">
                <div class="col-md-6">
                    <label class="form-label">Name</label>
                </div>
                <div class="col-md-3">
                    <label class="form-label">State</label>
                </div>
            </div>
            @foreach (var objective in quest.Objectives) {
            <div class="row">
                <div class="col-md-6">
                    <label class="form-label">@objective.Name</label>
                </div>
                <div class="col-md-3">
                    @if (objective.IsReadOnly) {
                        <input class="form-control" type="text" readonly value="@objective.State" />
                    }
                    else {
                        <select class="form-select" @bind="objective.State">
                            <option value="None">None</option>
                            <option value="Started">Started</option>
                            <option value="Completed">Completed</option>
                            <option value="Failed">Failed</option>
                        </select>
                    }
                </div>
            </div>
            }
        </div>
    </Accordion>
    }
</AccordionContainer>

@code {
    [Parameter]
    public bool EnableSpoilerAlert { get; set; }

    [Parameter]
    public IEnumerable<IGameStateQuestEntry> Quests { get; set; }
}