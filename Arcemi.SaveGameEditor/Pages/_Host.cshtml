@page "/"
@namespace Arcemi.SaveGameEditor.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en" data-editor-version="@Program.Version">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="Content-Security-Policy"
          content="default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ws://localhost:* http://localhost:* https://localhost:*;" />
    <title>Arcemi Editor @Program.Version</title>
    <base href="~/" />
    <link rel="icon" type="image/png" href="~/images/app-icon.png" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/bootstrap/bootstrap.min.css" asp-append-version="true" />
    <link href="~/css/main.css" rel="stylesheet" asp-append-version="true" />
    <link href="arcemi-save-game-editor.styles.css" rel="stylesheet" />
</head>
<body>
    @await Html.PartialAsync("_EditorTitleBar")
    <component type="typeof(Shared.EditorRoot)" render-mode="ServerPrerendered" />

    @await Html.PartialAsync("_EditorErrorDialog")
    <div id="blazor-error-ui" role="alert">
        The editor session stopped responding. <a href="" class="reload">Reload editor</a>
    </div>

    <script src="~/js/editor-errors.js" asp-append-version="true"></script>
    <script src="_framework/blazor.server.js"></script>
</body>
</html>
