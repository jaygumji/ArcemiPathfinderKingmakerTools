<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
	  <RuntimeIdentifiers>win-x64;linux-x64;osx-x64</RuntimeIdentifiers>
    <Version>1.0.1</Version>
    <StartupObject></StartupObject>
  </PropertyGroup>
  <PropertyGroup Label="ElectronNetCommon">
    <ElectronPackageId>arcemi-save-game-editor</ElectronPackageId>
    <Title>Arcemi Save Game Editor</Title>
    <Description>Save game editor for Pathfinder and Rogue Trader titles.</Description>
    <Company>Arcemi</Company>
    <Copyright>Copyright © 2025</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="wwwroot\images\Portraits\kingmaker-overrides\**" />
    <Content Remove="wwwroot\images\Portraits\kingmaker-overrides\**" />
    <EmbeddedResource Remove="wwwroot\images\Portraits\kingmaker-overrides\**" />
    <None Remove="wwwroot\images\Portraits\kingmaker-overrides\**" />
  </ItemGroup>
  <ItemGroup>
    <None Include="compilerconfig.json" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="ElectronNET.Core" Version="0.4.1-pre.40" />
    <PackageReference Include="ElectronNET.Core.AspNet" Version="0.4.1-pre.40" />
    <PackageReference Include="ElectronNET.Core.API" Version="0.4.1-pre.40" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="SharpCompress" Version="0.35.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Arcemi.Models\Arcemi.Models.csproj" />
  </ItemGroup>
  <Target Name="CleanElectronHostHookNodeModule" BeforeTargets="Build">
    <PropertyGroup>
      <_ElectronHostHookNodeModule>$(OutDir).electron\node_modules\electron-host-hook</_ElectronHostHookNodeModule>
    </PropertyGroup>
    <Delete Files="$(_ElectronHostHookNodeModule)" Condition="Exists('$(_ElectronHostHookNodeModule)')" />
    <RemoveDir Directories="$(_ElectronHostHookNodeModule)" Condition="Exists('$(_ElectronHostHookNodeModule)')" />
  </Target>
  <Target Name="CleanElectronHostHookNodeModuleBeforeConfigure" BeforeTargets="ElectronConfigureApp">
    <PropertyGroup>
      <_ElectronOutDir>$(OutDir).electron\</_ElectronOutDir>
      <_ElectronNodeModulesDir>$(_ElectronOutDir)node_modules</_ElectronNodeModulesDir>
      <_ElectronHostHookNodeModule>$(OutDir).electron\node_modules\electron-host-hook</_ElectronHostHookNodeModule>
      <_ElectronNpmConfigFile>$(_ElectronOutDir).npmrc</_ElectronNpmConfigFile>
    </PropertyGroup>
    <WriteLinesToFile
      File="$(_ElectronNpmConfigFile)"
      Lines="install-links=false&#x0A;bin-links=false&#x0A;audit=false&#x0A;fund=false&#x0A;loglevel=error"
      Overwrite="true" />
    <RemoveDir Directories="$(_ElectronNodeModulesDir)" Condition="Exists('$(_ElectronNodeModulesDir)')" />
    <Delete Files="$(_ElectronHostHookNodeModule)" Condition="Exists('$(_ElectronHostHookNodeModule)')" />
    <RemoveDir Directories="$(_ElectronHostHookNodeModule)" Condition="Exists('$(_ElectronHostHookNodeModule)')" />
  </Target>
  <Target Name="PatchElectronIntermediatePackageJson" BeforeTargets="ElectronConfigureApp" DependsOnTargets="ElectronCreatePackageJson;ElectronSetPaths" Condition="Exists('$(ElectronIntermediatePackageJson)')">
    <Exec Command="pwsh -NoProfile -Command &quot;$p='$(ElectronIntermediatePackageJson)'; $obj=Get-Content -Raw $p | ConvertFrom-Json; if($obj.dependencies -and $obj.dependencies.PSObject.Properties['electron-host-hook']){ $obj.dependencies.PSObject.Properties.Remove('electron-host-hook') }; $obj | ConvertTo-Json -Depth 32 | Set-Content -NoNewline $p&quot;" />
  </Target>
</Project>
