<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
	  <RuntimeIdentifiers>win-x64;linux-x64;osx-x64</RuntimeIdentifiers>
    <Version>3.0.0</Version>
    <StartupObject></StartupObject>
  </PropertyGroup>
  <PropertyGroup Label="ElectronNetCommon">
    <ElectronVersion>45.5.0</ElectronVersion>
    <ElectronBuilderVersion>26.18.0</ElectronBuilderVersion>
    <ElectronIcon>wwwroot/images/app-icon.png</ElectronIcon>
    <ElectronPackageId>arcemi-save-game-editor</ElectronPackageId>
    <Title>Arcemi Save Game Editor</Title>
    <Description>Save game editor for Pathfinder and Rogue Trader titles.</Description>
    <Company>Arcemi</Company>
    <Copyright>Copyright © 2025</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="wwwroot\images\Portraits\kingmaker-overrides\**" />
    <Content Remove="wwwroot\images\Portraits\kingmaker-overrides\**" />
    <EmbeddedResource Remove="wwwroot\images\Portraits\kingmaker-overrides\**" />
    <None Remove="wwwroot\images\Portraits\kingmaker-overrides\**" />
  </ItemGroup>
  <ItemGroup>
    <None Include="compilerconfig.json" />
    <EditorElectronHostFile Include="Properties/editor-window-state.js;Properties/custom_main.js;Properties/startup.html" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="ElectronNET.Core" Version="0.6.0" />
    <PackageReference Include="ElectronNET.Core.AspNet" Version="0.6.0" />
    <PackageReference Include="ElectronNET.Core.API" Version="0.6.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="SharpCompress" Version="0.50.11" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Arcemi.Models\Arcemi.Models.csproj" />
  </ItemGroup>
  <Target Name="SetDefaultElectronRuntimeIdentifier" BeforeTargets="ElectronResolveRuntimeIdentifier"
          Condition="'$(ElectronRuntimeIdentifier)' == '' And '$(RuntimeIdentifier)' == ''">
    <PropertyGroup>
      <ElectronRuntimeIdentifier>$(NETCoreSdkPortableRuntimeIdentifier)</ElectronRuntimeIdentifier>
    </PropertyGroup>
  </Target>
  <Target Name="PrepareElectronHost" BeforeTargets="ElectronResolvePaths" DependsOnTargets="ElectronCreatePackageJson">
    <PropertyGroup>
      <_PatchedElectronHostPath>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(ElectronIntermediateOutputPath)', 'host'))</_PatchedElectronHostPath>
    </PropertyGroup>
    <ItemGroup>
      <_ElectronHostFiles Include="$(ElectronSourceFilesPath)\**\*"
                          Exclude="$(ElectronSourceFilesPath)\main.js;$(ElectronSourceFilesPath)\api\browserWindows.js" />
    </ItemGroup>
    <Copy SourceFiles="@(_ElectronHostFiles)"
          DestinationFiles="@(_ElectronHostFiles->'$(_PatchedElectronHostPath)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(EditorElectronHostFile)" DestinationFolder="$(_PatchedElectronHostPath)" SkipUnchangedFiles="true" />
    <Exec Command="node &quot;$(MSBuildProjectDirectory)/Properties/prepare-electron-host.cjs&quot; &quot;$(ElectronIntermediatePackageJson)&quot; &quot;$([MSBuild]::NormalizePath('$(ElectronSourceFilesPath)', 'main.js'))&quot; &quot;$([MSBuild]::NormalizePath('$(_PatchedElectronHostPath)', 'main.js'))&quot;" />
    <PropertyGroup>
      <ElectronSourceFilesPath>$(_PatchedElectronHostPath)</ElectronSourceFilesPath>
    </PropertyGroup>
  </Target>
  <Target Name="CollectEditorElectronHostUpToDateFiles" AfterTargets="ElectronCollectUpToDateCheckBuiltDesignTime"
          DependsOnTargets="ElectronResolvePaths">
    <ItemGroup>
      <UpToDateCheckBuilt Include="$(OutDir)$(ElectronDirName)/%(EditorElectronHostFile.Filename)%(EditorElectronHostFile.Extension)"
                          Original="%(EditorElectronHostFile.FullPath)" />
    </ItemGroup>
  </Target>
</Project>
